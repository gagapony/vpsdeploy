# Cloudflare API 凭证（DNS 迁移脚本 + acme.sh DNS-01 签发需要）
CF_Token="your_cloudflare_api_token_here"
CF_Account_ID="your_cloudflare_account_id_here"
ACME_EMAIL="your_email@gmail.com"

# --- 网络拓扑信息 ---
DOMAIN_MAIN="your_domain.com"
DOMAIN_HOME_TARGET="home_target.com:8443"

# Only enable this on a VPS that exposes Clover through a reverse tunnel.
CHISEL_TUNNEL_ENABLED="false"
CHISEL_PORT="9000"
CHISEL_REVERSE_BIND="127.0.0.1"
CHISEL_REVERSE_PORT="9443"
CHISEL_AUTH="user:replace-with-a-long-random-password"
