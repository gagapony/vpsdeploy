# Cloudflare API 凭证（acme.sh DNS-01 签发需要；dns_cf 只读 CF_Token）
CF_Token="your_cloudflare_api_token_here"
ACME_EMAIL="your_email@gmail.com"

# --- 系统初始化（all 命令的 docker 开关，默认不装） ---
INIT_WITH_DOCKER="false"

# --- 网络拓扑信息 ---
DOMAIN_MAIN="your_domain.com"
DOMAIN_HOME_TARGET="home_target.com:8443"

# --- Chisel 反向隧道（仅在跑 Clover 隧道的中转机上开启） ---
CHISEL_TUNNEL_ENABLED="false"
CHISEL_PORT="9000"
CHISEL_REVERSE_BIND="127.0.0.1"
CHISEL_REVERSE_PORT="9443"
CHISEL_AUTH="user:replace-with-a-long-random-password"

# --- Xray Reality 节点（开启后 deploy 会一并部署） ---
# 密钥生成: ./vps-router.sh xray keys
#   Private key -> XRAY_PRIVATE_KEY；公钥 -> 客户端链接 pbk= 参数
# shortId 可用: openssl rand -hex 8
XRAY_ENABLED="false"
XRAY_UUID="replace-with-client-uuid"
XRAY_PRIVATE_KEY="replace-with-x25519-private-key"
XRAY_SHORT_ID="replace-with-8-byte-hex"
XRAY_DEST="www.tesla.com:443"
XRAY_SERVER_NAME="www.tesla.com"
