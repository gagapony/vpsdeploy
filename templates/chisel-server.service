[Unit]
Description=Chisel reverse tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chisel
Group=chisel
EnvironmentFile=/etc/chisel/server.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/chisel server --reverse --port ${CHISEL_PORT} --auth "$(cat /etc/chisel/auth)" --tls-cert /etc/chisel/fullchain.pem --tls-key /etc/chisel/privkey.pem'
Restart=always
RestartSec=3s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
